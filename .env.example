# cuthulu notification settings. Copy to .env and fill in:  cp .env.example .env
# compose.yaml reads .env if it exists, and so does `cargo run` (from the directory it is
# started in; variables set in the shell win). Never commit .env (it is in .gitignore).
# Format: KEY=value, one per line, no quotes and no spaces around '='.
# Everything here is optional; see docs/DEPLOYMENT.md#notifications.

# Master switch: false turns off both emails and healthcheck pings.
CUTHULU_NOTIFY_ENABLED=true

# --- Email ----------------------------------------------------------------------------------
# Watched services going down / coming back, and Cuthulu itself stopping.
# Unset CUTHULU_SMTP_HOST = no email. Port 465 = implicit TLS, any other (e.g. 587) = STARTTLS.
# Gmail: an app password (https://myaccount.google.com/apppasswords), spaces removed.
# Sender defaults to the username, recipient to the sender.
# CUTHULU_SMTP_HOST=smtp.gmail.com
# CUTHULU_SMTP_PORT=465
# CUTHULU_SMTP_TLS overrides the port-based choice: implicit or starttls (none: localhost tests only).
# CUTHULU_SMTP_TLS=
# CUTHULU_SMTP_USERNAME=you@gmail.com
# CUTHULU_SMTP_PASSWORD=
# CUTHULU_NOTIFY_EMAIL_FROM=
# CUTHULU_NOTIFY_EMAIL_TO=

# Least time between two "down" emails for the same service (crash loops), minutes.
# CUTHULU_NOTIFY_COOLDOWN_MINUTES=15
# Machine name in subjects; inside a container the host name is not visible.
# CUTHULU_NOTIFY_HOST=home-server

# --- Healthcheck (dead-man's switch) --------------------------------------------------------
# Pinged every N minutes; healthchecks.io alerts you when the pings stop (machine off,
# Cuthulu down, or Cuthulu cannot reach Docker). Keep the URL secret.
# CUTHULU_HEALTHCHECK_URL=https://hc-ping.com/<uuid>
# CUTHULU_HEALTHCHECK_INTERVAL_MINUTES=5
# Page the topbar's healthchecks.io button opens (not secret); default https://healthchecks.io/.
# CUTHULU_HEALTHCHECK_LINK=https://healthchecks.io/projects/<project-uuid>/checks/

# --- Env file editor (docs/DEPLOYMENT.md#editing-env-files) --------------------------------
# Your login on the host: "edit env" checks its sudo password (never root's). scripts/install.sh
# sets it; unset disables the editor.
# CUTHULU_HOST_USER=you
# Image of the short-lived host helper container (needs nsenter); default: busybox pinned by digest.
# CUTHULU_HELPER_IMAGE=busybox@sha256:<digest>

# --- Access ---------------------------------------------------------------------------------
# Extra host names to answer to (localhost, IPs, single-word names, *.ts.net, .local, .lan,
# .home.arpa and .internal always work). name, .domain (with subdomains), or * for any.
# CUTHULU_ALLOWED_HOSTS=dash.example.com

# HTTPS on the tailnet through the tailscale sidecar in compose.yaml
# (docs/DEPLOYMENT.md#https-on-the-tailnet). Pass TS_AUTHKEY on the command line for the
# first start instead of storing it here: the cuthulu container reads this file too.
# COMPOSE_PROFILES=tailscale
# TS_HOSTNAME=cuthulu
